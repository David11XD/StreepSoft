#1. Ocultar el listado de archivos en directorios
Options -Indexes

#2. Definir codificación de caracteres por defecto
AddDefaultCharset UTF-8

#3. Configuración de URLs Amigables
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Ruta base
    RewriteBase /streepsoft/
    
    # No redirigir si es archivo real
    RewriteCond %{REQUEST_FILENAME} !-f
    
    # No redirigir si es carpeta real
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Redirigir a public/index.php 
    RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
</IfModule>